# Copy to .env before `docker compose up -d`. .env is gitignored; never commit a real one.
#
# SQL Server rejects a password under 8 characters or missing three of {upper, lower, digit, symbol},
# and does it by exiting the container with a message that does not say so.
MSSQL_SA_PASSWORD=Local_Dev_Password_1

# Optional. Points `dotnet ef migrations add` / `database update` at something other than the
# compose instance above. Deliberately separate from ConnectionStrings__BuildCv so that changing
# where the application runs cannot silently change where migrations get applied.
# BUILDCV_MIGRATIONS_CONNECTION=Server=localhost,1433;Database=BuildCv;User Id=sa;Password=Local_Dev_Password_1;TrustServerCertificate=True;Encrypt=False


# ── Only for docker-compose.app.yml, which runs the API and the web client ────────────────────────
#
# THE VALUES BELOW ARE PLACEHOLDERS AND MUST BE REPLACED, including for a laptop. They are printed in
# a committed file, so anything left as-is is a key an attacker already has. The app refuses to start
# without them rather than inventing defaults, which is why they are listed here at all.
#
# Generate the two base64 keys with:
#   openssl rand -base64 32

# 32 characters or more. Shorter and the app refuses to start.
BUILDCV_JWT_SIGNING_KEY=replace-me-with-at-least-32-characters-long

# Key MATERIAL only. The key IDS are literals in docker-compose.app.yml (v1 and b1) because Compose
# does not substitute variables in a mapping key — rotating means editing that file to add a second
# entry and move the active pointer, never repointing an existing id at new material.
BUILDCV_ENCRYPTION_KEY=REPLACE_ME_base64_32_bytes==

# A separate ring with its own pointer. It indexes the columns that must stay searchable while
# encrypted; a read uses EVERY configured key so a rotation window cannot make an account unfindable.
BUILDCV_BLIND_INDEX_KEY=REPLACE_ME_base64_32_bytes==
