# Origin of BuildCv.Api. Only the Next.js server reads this — it is never sent to the browser,
# which is why it has no NEXT_PUBLIC_ prefix.
#
# `dotnet run --project src/BuildCv.Api` listens on https://localhost:7001 / http://localhost:5001
# by default; check the console output on first run and match it here.
BUILDCV_API_ORIGIN=http://localhost:5001

# Set to 1 when pointing at an https API whose certificate is the ASP.NET Core dev certificate.
# Node rejects it otherwise. Never set this outside local development.
BUILDCV_ALLOW_SELF_SIGNED=0
