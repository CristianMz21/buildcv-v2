{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      // WITHOUT THIS, CorrelationIdMiddleware DOES NOTHING AN OPERATOR CAN USE. It opens an
      // ILogger scope keyed CorrelationId around the whole pipeline and echoes the id back as
      // X-Correlation-ID, but the console formatter drops scopes unless asked — the default is
      // false — so the header reached the caller while not one log line carried the id. A user
      // reporting "I got error abc123" had nothing to match it against.
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "buildcv-api",
    "Audience": "buildcv-bff",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Network": {
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  }
}
