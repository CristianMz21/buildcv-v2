{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // No ConnectionStrings section on purpose. With none configured, Development falls back to
  // BuildCvDbContextFactory.DefaultConnectionString, which is the single committed copy of the local
  // string and already matches docker-compose.yml — so `docker compose up -d` and `dotnet run` work with
  // no setup. To point at your own instance, set ConnectionStrings:BuildCv (user secrets or the
  // ConnectionStrings__BuildCv environment variable) instead of adding it back here.
  "Persistence": {
    "Provider": "SqlServer",
    "AutoMigrate": true
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-min-32-characters-long-do-not-use-in-prod"
  },
  "Encryption": {
    "ActiveKeyId": "dev-v1",
    "Keys": {
      "dev-v1": {
        "Aes": "SUcLJu1U3OAVv8dS5Hnm+WVpjSi4jEiFsNgIMr6B+wI="
      }
    },
    "BlindIndex": {
      "ActiveKeyId": "dev-b1",
      "Keys": {
        "dev-b1": "ABIfUqN0e9vhyllPCcq8/NovGg2Vxt9wsEVn8MZckTY="
      }
    }
  }
}
