{
  // Production-only overlay. It carries NO secrets and cannot: Jwt:SigningKey, the Encryption key
  // ring and ConnectionStrings:BuildCv arrive as environment variables or Key Vault references, and
  // the app refuses to start without them rather than inventing a default. Nothing here is a value
  // an attacker would want.
  "Logging": {
    "LogLevel": {
      // ACCESS LOG. Hosting writes "Request starting"/"Request finished" at Information, and the
      // base file filters the whole Microsoft.AspNetCore category to Warning — so a deployment had
      // no record of what was requested at all. Raised for Hosting alone rather than by relaxing
      // the category, because the rest of Microsoft.AspNetCore at Information is noise.
      "Microsoft.AspNetCore.Hosting": "Information"
    },
    "Console": {
      // INCLUDESCOPES LIVES HERE, not beside FormatterName, and the difference is silent. The base file
      // sets Logging:Console:IncludeScopes, which is the LEGACY path the simple formatter reads. The
      // moment this overlay switches FormatterName to json, the formatter takes its options from
      // FormatterOptions instead and that legacy setting stops applying.
      //
      // Measured before this line existed: a request sent with X-Correlation-ID: trace-me-9876 got the
      // id echoed back in the response header, and NOT ONE log line carried it -- including the audit
      // line the request wrote from inside the scope. The correlation id worked for the caller and was
      // useless to whoever had to find the request.
      //
      // CorrelationIdTests does not catch this: it reads the scope through IExternalScopeProvider, which
      // is what the console formatter consumes, not the formatting itself.
      "FormatterOptions": {
        "IncludeScopes": true
      },
      // A log aggregator cannot filter on a field it has to parse out of a sentence. The default
      // "Simple" formatter renders scopes as trailing text, so the CorrelationId the base file
      // turns on would arrive as prose rather than as a queryable property.
      "FormatterName": "json"
    }
  }
}
