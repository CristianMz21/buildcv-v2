<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!--
      SMTP, MIT-licensed, and the reason it is a dependency at all: System.Net.Mail.SmtpClient is
      marked obsolete for new development and this project builds with TreatWarningsAsErrors, so the
      framework option is not an option. MailKit is what the obsoletion message itself points at.
    -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />

    <!--
      TRANSITIVE, pinned forward. Nothing here references this: it arrives as
      EntityFrameworkCore.SqlServer to Microsoft.Data.SqlClient to Azure.Identity to
      Microsoft.Identity.Client, and the 4.73.1 that chain resolves is flagged by its own authors as
      deprecated for CRITICAL BUGS. Run `dotnet list package` with the deprecated and include-transitive
      switches to see it.

      It is not on this deployment's execution path: Azure.Identity is how SqlClient authenticates to
      SQL Server with Entra ID, and the connection string here uses a SQL login. But docs/deployment.md
      recommends a MANAGED instance, and managed instances are exactly where Entra ID auth is the normal
      choice, so the path a deployment is being pointed at is the one that would use it.

      Removing this line does not remove the package. It only puts the flagged version back.
    -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildCv.Application\BuildCv.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The skill lexicon is DATA, compiled in. LogicalName is stated rather than derived from the
         folder, so moving the file is a build-time rename here instead of a runtime
         MissingManifestResourceException on the first score. -->
    <EmbeddedResource Include="Lexicon\SkillLexicon.txt" LogicalName="BuildCv.Infrastructure.Lexicon.SkillLexicon.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The EF value converters are internal: they are wiring for this assembly's own model, not a
         public API. The test project needs to exercise them as plain functions. -->
    <InternalsVisibleTo Include="BuildCv.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn />
  </PropertyGroup>

</Project>
